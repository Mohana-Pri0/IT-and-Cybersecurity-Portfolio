# Dashboard Panel 1: Failed Logins Over Time

index=main sourcetype=security_detection_lab
event_type="login" outcome="failure"
| timechart span=10m count as failed_logins


# Dashboard Panel 2: Failed Login Attempts by User

index=main sourcetype=security_detection_lab
event_type="login" outcome="failure"
| stats count as failed_attempts by user
| sort - failed_attempts


# Dashboard Panel 3: Failed Login Attempts by Source IP

index=main sourcetype=security_detection_lab
event_type="login" outcome="failure"
| stats count as failed_attempts by src_ip
| sort - failed_attempts


# Dashboard Panel 4: Successful Login After Repeated Failures

index=main sourcetype=security_detection_lab event_type="login"
| sort 0 user src_ip _time
| streamstats count(eval(outcome="failure")) as prior_failures by user src_ip
| where outcome="success" AND prior_failures >= 5
| table _time user src_ip device location prior_failures details


# Dashboard Panel 5: Multiple Accounts Targeted From One Source

index=main sourcetype=security_detection_lab
event_type="login" outcome="failure"
| stats dc(user) as unique_users
        count as failed_attempts
        values(user) as targeted_users
        by src_ip
| where unique_users >= 3 AND failed_attempts >= 5
| sort - unique_users


# Dashboard Panel 6: VPN Activity Requiring Review

index=main sourcetype=security_detection_lab event_type="vpn"
| where location="Unknown" OR device="UNKNOWN-DEVICE"
| table _time user src_ip device location outcome details
| sort _time


# Dashboard Panel 7: Privileged Group Changes

index=main sourcetype=security_detection_lab
event_type="account_change"
| search details="*privileged group*"
| table _time user src_ip device location outcome details

